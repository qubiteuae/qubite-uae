# Copy to .env for local `vercel dev` testing, and add the same variables in
# Vercel's dashboard (Project Settings > Environment Variables) for production.

# Required. Get a free key at https://resend.com after signing up.
RESEND_API_KEY=

# Optional overrides — sensible defaults are used if omitted.
# RESEND_FROM="Qubite Website <onboarding@resend.dev>"
# CONTACT_TO_EMAIL=info@qubite-international.com

# Maintenance mode — set to "true" to replace the entire site with a single
# maintenance page (all routes, both /en and /ar). This is a Vite build-time
# flag: after changing it in Vercel's Environment Variables, you must trigger
# a new deployment (Deployments > ... > Redeploy) for the change to take
# effect — env var edits alone do not update a live static build.
# VITE_MAINTENANCE_MODE=true
